{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenAPI Pruner",
    "version": "1.0.0"
  },
  "security": [
    {
      "publicAuth": []
    }
  ],
  "tags": [
    {
      "name": "public"
    },
    {
      "name": "internal"
    }
  ],
  "paths": {
    "/pets": {
      "parameters": [
        {
          "$ref": "#/components/parameters/tenantId"
        }
      ],
      "get": {
        "tags": ["public"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Shared"
                    },
                    {
                      "$ref": "#/components/schemas/PublicOnly"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["internal"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalOnly"
                }
              }
            }
          }
        }
      }
    },
    "/admin": {
      "get": {
        "security": [
          {
            "internalAuth": []
          }
        ],
        "tags": ["internal"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Shared"
                }
              }
            }
          }
        }
      }
    },
    "/authored-empty": {},
    "/operationless": {
      "parameters": [
        {
          "$ref": "#/components/parameters/operationlessPath"
        }
      ]
    }
  },
  "webhooks": {
    "authored-empty": {},
    "operationless": {
      "parameters": [
        {
          "$ref": "#/components/parameters/operationlessWebhook"
        }
      ]
    }
  },
  "components": {
    "parameters": {
      "tenantId": {
        "in": "header",
        "name": "tenant-id",
        "schema": {
          "type": "string"
        }
      },
      "operationlessPath": {
        "in": "header",
        "name": "path-id",
        "schema": {
          "type": "string"
        }
      },
      "operationlessWebhook": {
        "in": "header",
        "name": "webhook-id",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Shared": {
        "type": "object"
      },
      "PublicOnly": {
        "type": "object"
      },
      "InternalOnly": {
        "type": "object"
      },
      "Unused": {
        "type": "object"
      }
    },
    "securitySchemes": {
      "publicAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "public-key"
      },
      "internalAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "internal-key"
      }
    }
  }
}
