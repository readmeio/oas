{
  "openapi": "3.1.0",
  "info": {
    "title": "Path Item and webhook $ref targets",
    "description": "A path and webhook reuse another Path Item via `$ref`, and a third path reuses path-level parameters. The transformer must retain those targets instead of leaving dangling pointers.",
    "version": "1.0.0"
  },
  "paths": {
    "/pets": {
      "parameters": [
        {
          "name": "tenant",
          "in": "header",
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/animals": {
      "$ref": "#/paths/~1pets"
    },
    "/stores": {
      "get": {
        "parameters": [
          {
            "$ref": "#/paths/~1pets/parameters/0"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "webhooks": {
    "petCreated": {
      "post": {
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "animalCreated": {
      "$ref": "#/webhooks/petCreated"
    }
  }
}
