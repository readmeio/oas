{
  "openapi": "3.1.0",
  "info": {
    "title": "Cross-referenced path and webhook operations",
    "description": "A path operation `$ref`s a webhook schema and a webhook `$ref`s a path schema so the transformer can retain both directions.",
    "version": "1.0.0"
  },
  "paths": {
    "/orders": {
      "get": {
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/webhooks/orderCreated/post/requestBody/content/application~1json/schema"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "webhooks": {
    "orderCreated": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "inventoryChanged": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/paths/~1orders/get/responses/200/content/application~1json/schema"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}
