{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      // Setting `lib` replaces the default library for our `target` so it must be re-added here.
      "ES2024",

      // Needed because `@apidevtools/json-schema-ref-parser` uses `window` and `location`.
      "DOM"
    ],

    // TypeScript 7 enables `strict` by default but this package has not yet been migrated to it.
    "strict": false,

    // Required so the filesystem `$ref` jail's `node:` imports typecheck. This package does not
    // pick up `@types/node` on its own.
    "types": ["node"]
  },
  "include": ["./src/**/*"],
  "exclude": ["dist"]
}
